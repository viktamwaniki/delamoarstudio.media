<script>
// ---- Intro ----
const intro = document.getElementById('intro');
function closeIntro(){ intro.classList.add('hide'); }
setTimeout(closeIntro, 2600);
document.getElementById('skipIntro').addEventListener('click', closeIntro);

// ---- Nav scroll state ----
const nav = document.getElementById('nav');
window.addEventListener('scroll', ()=>{
  nav.classList.toggle('scrolled', window.scrollY > 40);
});

// ---- Cursor glow (desktop only) ----
const glow = document.getElementById('glow');
if(matchMedia('(hover:hover)').matches){
  window.addEventListener('mousemove', e=>{
    glow.style.left = e.clientX+'px';
    glow.style.top = e.clientY+'px';
    glow.classList.add('active');
  });
}

// ---- Work grid data ----
const categories = ['photography','film','portraits','fashion','events','weddings','automotive','commercial'];
const workData = [
  {cat:'photography', title:'Editorial Light', seed:'dw1'},
  {cat:'film', title:'Northbound Reel', seed:'dw2'},
  {cat:'portraits', title:'Quiet Focus', seed:'dw3'},
  {cat:'fashion', title:'Season Study', seed:'dw4'},
  {cat:'events', title:'Live at Dusk', seed:'dw5'},
  {cat:'weddings', title:'Amara & Kagunda', seed:'dw6'},
  {cat:'automotive', title:'Line & Chrome', seed:'dw7'},
  {cat:'commercial', title:'Solei Launch', seed:'dw8'},
  {cat:'photography', title:'Field Notes', seed:'dw9'},
  {cat:'film', title:'Kitengela House', seed:'dw10'},
  {cat:'portraits', title:'Half Light', seed:'dw11'},
  {cat:'fashion', title:'Mara & Co', seed:'dw12'},
];
const workGrid = document.getElementById('workGrid');
workGrid.innerHTML = workData.map(w=>`
  <div class="work-item" data-cat="${w.cat}">
    <img src="https://picsum.photos/seed/${w.seed}/700/900" alt="${w.title}" loading="lazy">
    <div class="work-info">
      <div class="work-cat">${w.cat}</div>
      <div class="work-title">${w.title}</div>
    </div>
  </div>
`).join('');

const filters = document.querySelectorAll('.filter-btn');
filters.forEach(btn=>{
  btn.addEventListener('click', ()=>{
    filters.forEach(b=>b.classList.remove('active'));
    btn.classList.add('active');
    const f = btn.dataset.filter;
    document.querySelectorAll('.work-item').forEach(item=>{
      item.classList.toggle('hidden', f!=='all' && item.dataset.cat!==f);
    });
  });
});

// ---- Services ----
const services = [
  'Photography','Portraits','Weddings','Event Coverage','Video Production',
  'Commercial Content','Creative Campaigns','Automotive','Creator Content','Business & Brand Media'
];
const seeds = ['dsv1','dsv2','dsv3','dsv4','dsv5','dsv6','dsv7','dsv8','dsv9','dsv10'];
document.getElementById('serviceGrid').innerHTML = services.map((s,i)=>`
  <div class="service-card" style="--bgimg:url('https://picsum.photos/seed/${seeds[i]}/700/500')">
    <div class="service-num">${String(i+1).padStart(2,'0')}</div>
    <div class="service-name">${s}</div>
  </div>
`).join('');
document.querySelectorAll('.service-card').forEach(c=>{
  const img = c.style.getPropertyValue('--bgimg');
  const styleTag = document.createElement('style');
});
document.querySelectorAll('.service-card').forEach((c,i)=>{
  c.style.setProperty('--i', i);
});
// apply background via ::before using inline custom prop workaround
const styleEl = document.createElement('style');
let rules = '';
document.querySelectorAll('.service-card').forEach((c,i)=>{
  rules += `.service-card:nth-child(${i+1})::before{background-image:${c.style.getPropertyValue('--bgimg')};}`;
});
styleEl.innerHTML = rules;
document.head.appendChild(styleEl);

// ---- Process scroll progress ----
const processEl = document.getElementById('process');
const processFill = document.getElementById('processFill');
const steps = document.querySelectorAll('.process-step');
function updateProcess(){
  const rect = processEl.getBoundingClientRect();
  const vh = window.innerHeight;
  let progress = (vh*0.75 - rect.top) / rect.height;
  progress = Math.max(0, Math.min(1, progress));
  processFill.style.height = (progress*100)+'%';
  const activeCount = Math.round(progress*steps.length);
  steps.forEach((s,i)=> s.classList.toggle('active', i < activeCount));
}
window.addEventListener('scroll', updateProcess);
updateProcess();

// ---- Booking mini-flow ----
const bookingSteps = [
  {label:'Step 01', title:'Choose your production', options:['Photography','Film','Wedding','Commercial']},
  {label:'Step 02', title:'Choose package', options:['Essential','Signature','Full Day']},
  {label:'Step 03', title:'Choose date & time', options:['Morning','Afternoon','Evening','Full Day']},
  {label:'Step 04', title:'Select location', options:['Studio','On Location','Client Choice']},
];
let bookingState = {step:0, picks:{}};
const bookPanel = document.getElementById('bookPanel');
const bookProgress = document.getElementById('bookProgress');

function renderProgress(){
  bookProgress.innerHTML = bookingSteps.map((_,i)=>`<span class="${i<bookingState.step?'done':''}"><i></i></span>`).join('');
}
function renderBooking(){
  if(bookingState.step >= bookingSteps.length){
    bookPanel.innerHTML = `
      <div class="book-step-label">Confirmed</div>
      <div class="book-step-title">You're booked with Delamoar</div>
      <p style="color:var(--muted);font-size:0.9rem;line-height:1.6;margin-bottom:1.6rem;">We'll follow up by email to confirm the final details and secure your date.</p>
      <button class="book-next" id="bookAgain">Book another</button>
    `;
    document.getElementById('bookAgain').addEventListener('click', ()=>{
      bookingState = {step:0, picks:{}};
      renderProgress(); renderBooking();
    });
    renderProgress();
    return;
  }
  const s = bookingSteps[bookingState.step];
  const picked = bookingState.picks[bookingState.step];
  bookPanel.innerHTML = `
    <div class="book-step-label">${s.label}</div>
    <div class="book-step-title">${s.title}</div>
    <div class="book-options">
      ${s.options.map(o=>`<div class="book-option ${picked===o?'sel':''}" data-opt="${o}">${o}</div>`).join('')}
    </div>
    <div class="book-nav">
      <button class="book-back" id="bookBack" ${bookingState.step===0?'disabled':''}>← Back</button>
      <button class="book-next" id="bookNext" ${picked?'':'disabled'}>${bookingState.step===bookingSteps.length-1?'Confirm':'Continue'}</button>
    </div>
  `;
  bookPanel.querySelectorAll('.book-option').forEach(el=>{
    el.addEventListener('click', ()=>{
      bookingState.picks[bookingState.step] = el.dataset.opt;
      renderBooking();
    });
  });
  document.getElementById('bookBack').addEventListener('click', ()=>{
    if(bookingState.step>0){ bookingState.step--; renderProgress(); renderBooking(); }
  });
  document.getElementById('bookNext').addEventListener('click', ()=>{
    bookingState.step++;
    renderProgress(); renderBooking();
  });
  renderProgress();
}
document.getElementById('bookRestart').addEventListener('click', (e)=>{
  e.preventDefault();
  bookingState = {step:0, picks:{}};
  renderProgress(); renderBooking();
  document.getElementById('book').scrollIntoView({behavior:'smooth'});
});
renderBooking();
</script>
